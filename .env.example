# Telegram Bot Token от @BotFather
BOT_TOKEN=your_bot_token_here

# Username бота без @ (для страницы статуса на Vercel)
BOT_USERNAME=your_bot_username

# --- База данных (выберите один вариант) ---

# Вариант A: Turso (рекомендуется для Vercel)
DATABASE_URL=libsql://your-db-name.aws-us-west-2.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Вариант B: PostgreSQL (Neon)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/wordbot

# Вариант C: SQLite (только локально)
# DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Часовой пояс для рассылки
TIMEZONE=Europe/Moscow

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Стоимость Premium подписки в Telegram Stars (30 дней)
PREMIUM_STARS_PRICE=150

# ID администраторов через запятую (для /test_premium)
ADMIN_IDS=123456789,987654321

# --- Vercel (production) ---
# Секрет для регистра webhook: /api/setup?secret=...
SETUP_SECRET=change_me_to_random_string

# Короткий код для /premium КОД и /test_premium КОД (если пусто — используется SETUP_SECRET)
PREMIUM_ACTIVATION_CODE=

# Секрет webhook (Telegram шлёт в заголовке X-Telegram-Bot-Api-Secret-Token)
WEBHOOK_SECRET=change_me_webhook_secret

# Секрет для Vercel Cron и GitHub Actions (должен совпадать с SETUP_SECRET или GitHub SETUP_SECRET)
CRON_SECRET=change_me_cron_secret

# Код верификации в каталоге @appss (команда /appss_verify)
APPSS_VERIFY_CODE=appss_8db7f6

# --- AI (опционально) ---
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# xAI/Grok: https://console.x.ai/
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Если задано, переопределяет GROQ_MODEL/XAI_MODEL
AI_MODEL=

# Публичный URL production (обязательно для webhook!)
WEBHOOK_BASE_URL=https://dudubot.vercel.app
