{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/api/cron/daily", "destination": "/api/cron_daily" }
  ],
  "functions": {
    "api/index.py": { "maxDuration": 10 },
    "api/health.py": { "maxDuration": 15 },
    "api/test_db.py": { "maxDuration": 30 },
    "api/self_check.py": { "maxDuration": 30 },
    "api/webhook.py": { "maxDuration": 60 },
    "api/setup.py": { "maxDuration": 30 },
    "api/migrate.py": { "maxDuration": 60 },
    "api/cron_daily.py": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron_daily", "schedule": "0 6 * * *" },
    { "path": "/api/cron_daily", "schedule": "0 9 * * *" }
  ]
}
