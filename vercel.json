{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": { "maxDuration": 10 },
    "api/health.py": { "maxDuration": 15 },
    "api/test_db.py": { "maxDuration": 30 },
    "api/self_check.py": { "maxDuration": 30 },
    "api/webhook.py": { "maxDuration": 60 },
    "api/setup.py": { "maxDuration": 30 },
    "api/migrate.py": { "maxDuration": 30 },
    "api/cron/daily.py": { "maxDuration": 60 }
  }
}
